# Environment for the Playwright suite, loaded by `vp build -m e2e` (see
# playwright.config.js). Committed, and it overrides .env for these keys, so a
# developer's real credentials never change what the E2E tests see — a local run
# and a CI run build the same app.

# Deliberately empty. The map view's "Google Maps API Key Required" notice is one
# of the things e2e/map.e2e.js asserts, and the create-flow spec does not need a
# key: it injects a window.google stub instead (see e2e/fixtures/app.js), which
# makes MapContainer skip loading Google's script altogether.
VITE_GOOGLE_MAPS_API_KEY=

# Both are required together for the cookie banner to mount at all
# (isAnalyticsConfigured in src/analytics.js), and e2e/consent.e2e.js is about the
# banner. The host is under .invalid, a TLD that by definition never resolves, and
# the fixtures abort every non-localhost request regardless — so accepting consent
# in a test starts PostHog against nothing and sends no data anywhere.
VITE_POSTHOG_KEY=phc_e2e_placeholder
VITE_POSTHOG_HOST=https://e2e.posthog.invalid

# The state e2e/admin-gate.e2e.js asserts: the admin routes refuse to render.
VITE_ADMIN_ENABLED=false
