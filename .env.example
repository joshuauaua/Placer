# Google Maps API Key
# Get your key from: https://console.cloud.google.com/google/maps-apis
# IMPORTANT: Restrict your API key to specific referrers (your deployed domain)
# in the Google Cloud Console to prevent unauthorized usage.
#
# This key needs THREE APIs enabled under "API restrictions":
#   - Maps JavaScript API      — the interactive map and Street View panorama
#   - Street View Static API   — capturing the panorama (a browser cannot
#                                screenshot it; see src/lib/staticMaps.js)
#   - Maps Static API          — the top-down fallback for spots with no
#                                Street View coverage
# A key with only Maps JavaScript API enabled loads the map fine but makes every
# capture fail with a 403.
#
# Note: under Google's EEA terms the Maps Static API refuses maptype=satellite
# and maptype=hybrid with a 403; only roadmap and terrain serve.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# PostHog Analytics
# Both are required together; with either missing PostHog is never initialised,
# no cookie banner is shown, and the posthog.capture() calls across the app are
# no-ops. Analytics are consent-gated even when these are set: PostHog is not
# loaded until the visitor accepts the cookie banner (see src/analytics.js).
# Host is the ingestion endpoint for your region, e.g.
# https://eu.i.posthog.com or https://us.i.posthog.com.
VITE_POSTHOG_KEY=your_posthog_project_api_key_here
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Admin Access
# Set to 'true' to enable the admin routes:
#   /admin              — the dashboard (analytics, survey responses, users, content)
#   /admin/imaginations — moderate posted imaginations, including deleting them
# Neither is linked from the UI; you reach them by typing the URL. Leave unset or
# 'false' in production unless you have added proper authentication — the gate is
# only a build-time flag, not authentication.
VITE_ADMIN_ENABLED=false

# Supabase
# Both are required together. With either missing the app still runs — everything is
# kept in the browser's localStorage — but two features are switched off, because
# neither can exist in a single browser:
#
#   Sandbox rooms, since a room is shared between devices by definition.
#   Accounts, since there is nowhere to keep one. Identity falls back to the
#   localStorage record in src/services/profile.js, which is what the app used
#   before accounts existed: a name for the imaginations you post, held on this
#   device only. There is no sign-up form and no password, and the account menu
#   logs you in and out of that record rather than of anything real.
#   The community map, since there is no community without a shared store.
#   Posting saves the imagination to this browser, the map shows only what this
#   browser has posted, and no account is required to post at all.
#
# Project URL and the anon/public key, from Settings -> API. Pick an EU region: the
# privacy and GDPR pages both state that data is stored in the EU, and that now
# covers accounts as well as survey answers — Supabase Auth keeps them in the same
# project.
#
# Accounts also need configuration that is not an environment variable: the email and
# Google providers have to be turned on in the dashboard and the redirect URLs
# registered, or signing in fails at the last step. See supabase/README.md section 9.
#
# The anon key is meant to be public and ships in the bundle; row-level security is
# what protects the data (see supabase/rooms.sql and supabase/auth.sql). NEVER put a
# service_role key in a VITE_ variable — everything so prefixed is compiled into the
# JavaScript the browser downloads.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Uploaded pictures (Cloudflare R2)
# Supabase keeps the tables and accounts; imagination previews and profile covers live
# in an R2 bucket. This is the bucket's PUBLIC address — the custom domain connected to
# it in Cloudflare, with no trailing path — and it is the only R2 value the browser
# ever sees. Unset, pictures are neither shown nor uploaded.
#
# The R2 access keys do NOT go here. They are secrets of the `media` Edge Function,
# which signs each upload for the signed-in account (supabase/functions/media), and are
# set with `supabase secrets set` — see supabase/README.md section 14.
VITE_MEDIA_URL=https://media.your-domain.example

# Storyblok — the articles on the Resources page
# Unset, the page shows its built-in sample posts and no article opens. The content
# model it reads (stories of the `case-study` content type) is described at the top
# of src/services/storyblok.js.
#
# Use the space's PUBLIC access token (Settings -> Access Tokens). It is compiled into
# the bundle like every VITE_ variable, and can only read published content. A Preview
# token also reads drafts: put one only in your own .env.local, with
# VITE_STORYBLOK_VERSION=draft, to see unpublished changes in the Visual Editor.
VITE_STORYBLOK_TOKEN=your_storyblok_public_token_here
# eu (the default), us, ca, ap or cn — whichever region the space was created in.
# VITE_STORYBLOK_REGION=eu
# VITE_STORYBLOK_VERSION=published
