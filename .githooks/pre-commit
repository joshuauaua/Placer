#!/bin/sh
# Only guards the commit that concludes a conflicted merge — git skips pre-merge-commit
# there and runs this instead. An ordinary commit is inspected and never blocked.
guard="$(git rev-parse --show-toplevel)/.githooks/guard-landingpage.sh"
if [ ! -x "$guard" ]; then
  # Fail open rather than blocking every commit in the repository over a missing file.
  # pre-push and the CI job both still refuse the holding page.
  echo "warning: $guard is missing — the landingpage merge guard did not run." >&2
  exit 0
fi
exec "$guard"
